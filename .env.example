# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.

# --- Option A: full DATABASE_URL (takes priority over DB_* vars below) ---
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# --- Option B: individual DB_* parts ---
DB_HOST=analytics-staging.c0q4keadjybw.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=analytics
DB_USER=analytics_staging
DB_PASSWORD=<your-staging-db-password>

# GitHub API key (optional — without it GitHub calls are rate-limited to 60/hr)
GITHUB_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False
